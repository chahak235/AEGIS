# Copy this file to backend/.env and fill in the values.
# backend/.env is ignored by Git, so your real passwords never reach GitHub.
# This example file IS committed, so it must never contain real secrets.

# The real database the app uses (from Neon dashboard -> Connect).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# A separate database used ONLY by the automated tests. Must be different from DATABASE_URL.
# Option A (local, fast): run "docker compose up -d" in the project folder, then use:
TEST_DATABASE_URL=postgresql://aegis:aegis_test_only@localhost:5433/aegis_test
# Option B (no Docker): create a "test" branch in the Neon dashboard and paste its URL here.

# Secret key that signs login tokens (JWT). At least 32 random characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value-from-the-command-above
# Optional: minutes a login stays valid (default 30).
# ACCESS_TOKEN_MINUTES=30
