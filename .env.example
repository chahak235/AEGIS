# Secrets for "docker compose --profile app" (and monitoring).
# Copy this file to .env in the same folder and fill in real values.
# .env is ignored by Git. This example file only has placeholders.
#
# Generate a random value with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use letters and digits only for POSTGRES_PASSWORD (it goes inside a URL).

POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-at-least-32-random-characters
GRAFANA_ADMIN_PASSWORD=change-me
